{
  "name": "summa-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons:build": "node scripts/build-icons.mjs",
    "validate:icons": "node scripts/validate-icons.mjs",
    "guidance:build": "node scripts/build-guidance.mjs",
    "validate:guidance": "node scripts/validate-guidance.mjs",
    "validate:antipatterns": "node scripts/validate-antipatterns.mjs",
    "validate:presets": "node scripts/validate-presets.mjs",
    "validate": "npm run guidance:build && npm run validate:icons && npm run validate:antipatterns && npm run validate:presets && npm run validate:guidance && npm run validate:feedback",
    "checks": "node scripts/run-checks.mjs",
    "test:browser": "node scripts/test-guidance.mjs",
    "test:tap": "node scripts/test-tap-targets.mjs",
    "test:workspace": "node --test scripts/test-workspace.mjs",
    "test:desktop-layout": "node scripts/layout-snapshot.mjs --compare docs/reports/desktop-layout-before.json",
    "vendor": "node scripts/vendor-guidance.mjs",
    "vendor:verify": "node scripts/verify-vendored.mjs",
    "validate:feedback": "node scripts/validate-feedback.mjs",
    "feedback": "node scripts/feedback.mjs",
    "regression": "node scripts/regression-check.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "record:usage": "node scripts/record-guidance-usage.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-static": "1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/feedback/usage.schema.json",
  "title": "summa-ui.usage.json: written into every application built with Summa-UI guidance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "guidance",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "bundleDigest"
      ],
      "properties": {
        "name": {
          "const": "summa-ui-guidance"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tag": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "recordedAt": {
      "type": "string"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principle",
          "reason"
        ],
        "properties": {
          "principle": {
            "type": "string",
            "pattern": "^P\\d{2}$"
          },
          "reason": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      },
      "description": "Deliberate departures from a principle (P22), each with a concrete usability reason."
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      }
    }
  }
}

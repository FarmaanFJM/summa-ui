{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/feedback/issue.schema.json",
  "title": "Design feedback issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "createdAt",
    "reportedBy",
    "application",
    "guidanceVersion",
    "component",
    "screenshots",
    "explanation",
    "classification",
    "status",
    "proposal"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FB-\\d{4}$"
    },
    "createdAt": {
      "type": "string"
    },
    "reportedBy": {
      "type": "string",
      "description": "Who raised it. The owner for design verdicts."
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "guidanceVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Guidance version the application recorded as used."
    },
    "component": {
      "type": "string",
      "description": "Affected component, screen or selector, named as the owner sees it."
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "Path relative to the issue folder."
          },
          "viewport": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 10,
      "description": "The owner's explanation, verbatim where possible."
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind"
      ],
      "properties": {
        "status": {
          "enum": [
            "unclassified",
            "proposed",
            "confirmed"
          ],
          "description": "proposed: suggested by an agent or reviewer. confirmed: the owner confirmed it."
        },
        "kind": {
          "enum": [
            null,
            "application-specific",
            "guidance-gap",
            "guidance-ambiguity",
            "guidance-incorrect",
            "not-a-problem"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "proposedBy": {
          "type": "string"
        },
        "confirmedBy": {
          "type": "string"
        },
        "confirmedAt": {
          "type": "string"
        }
      }
    },
    "relatedPrinciples": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P\\d{2}$"
      }
    },
    "relatedAntiPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AP-\\d{3}$"
      }
    },
    "status": {
      "enum": [
        "open",
        "triaged",
        "proposal-drafted",
        "resolved",
        "wont-fix"
      ]
    },
    "proposal": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PR-\\d{4}$"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "application-fix",
            "guidance-release",
            "declined"
          ]
        },
        "ref": {
          "type": "string"
        }
      }
    }
  }
}

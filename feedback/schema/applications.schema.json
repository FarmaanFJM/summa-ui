{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summa-ui/feedback/applications.schema.json",
  "title": "Registry of applications and the guidance version each used",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applications"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path",
          "guidanceVersion",
          "basis",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "guidanceVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "bundleDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "basis": {
            "enum": [
              "built-with",
              "retrofitted",
              "reference"
            ],
            "description": "built-with: produced using this guidance version. retrofitted: built earlier and brought into line with it. reference: approved interface kept as a regression baseline."
          },
          "status": {
            "enum": [
              "approved-reference",
              "active",
              "retired"
            ]
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "regression": {
            "type": "boolean",
            "description": "false: not an application interface, excluded from regression runs."
          }
        }
      }
    }
  }
}
